{
  "name": "dj",
  "version": "0.1.0",
  "description": "Two-deck DJ mixer in the browser: key lock, sync, EQ, effects, hot cues, loops, library, recording and MIDI.",
  "author": "Pandiyaraj Karuppasamy <pandiyarajk@live.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs http://localhost:4173/"
  },
  "dependencies": {
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
